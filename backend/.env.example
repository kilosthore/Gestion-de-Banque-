
# Copier ce fichier en ".env" et remplir les valeurs

# Base de données MySQL (la base est créée automatiquement au démarrage)
# ⚠️ PRODUCTION : ne PAS utiliser root — créer un utilisateur dédié avec mot de passe
#   CREATE USER 'banque'@'%' IDENTIFIED BY '<mot_de_passe_fort>';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, REFERENCES ON banque.* TO 'banque'@'%';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=banque
DB_NAME_TEST=banque_test
DB_USER=root
DB_PASS=

# Sécurité JWT — générer une clé unique PAR ENVIRONNEMENT (jamais réutiliser celle de dev en prod) :
#   openssl rand -base64 48
JWT_SECRET=changez_moi_par_une_longue_chaine_aleatoire_64_caracteres_minimum
JWT_EXPIRES=30m
TEMP_TOKEN_EXPIRES=5m

# Mot de passe du compte admin créé par "npm run seed" (8+ car., majuscule, minuscule, chiffre).
# Si vide, un mot de passe aléatoire est généré et affiché une seule fois dans la console du seed.
ADMIN_PASSWORD=

# Serveur
PORT=5000
CLIENT_URL=http://localhost:5173
# ⚠️ PRODUCTION : NODE_ENV=production active trust proxy, désactive le mode démo OTP
# et masque les détails d'erreurs internes. Obligatoire au déploiement.
# NODE_ENV=production

# Email pour l'envoi du code OTP (OBLIGATOIRE en production : sans SMTP, les
# clients ne reçoivent pas leur code et ne peuvent pas se connecter)
# Gmail : créer un "mot de passe d'application" sur https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# true = le code OTP est aussi renvoyé dans la réponse API (démo / présentation).
# Ignoré automatiquement quand NODE_ENV=production — le code n'est JAMAIS exposé en prod.
DEMO_OTP=true
